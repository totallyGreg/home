#autoload
# secrets — read/write secrets in the macOS keychain via the built-in `security`
# tool. Renamed + extended from `passwords`: adds multi-field support. A secret is
# a SERVICE plus a FIELD (the keychain "account"); FIELD defaults to $USER, so the
# old `secrets get NAME` / `secrets set NAME VALUE` keep working. Use `-f <field>`
# to keep several fields under one service (e.g. many creds per tenant).
#
#   secrets get  <service> [-f field]            print a value (field default: $USER)
#   secrets set  <service> [value] [-f field]    store; secure prompt if value omitted
#   secrets list [service]                        list a service's fields, or fzf-browse all
#   secrets rm   <service> [-f field]             delete a field
#   secrets keychains | certs                     browse keychains / certificates
#
# Options: -f/--field <field>, -k/--keychain <keychain>
# Autoloaded (no shebang; `#autoload` must stay line 1). A standalone executable
# copy lives at airs-tasks/bin/secrets (used by mise tenant files via exec()).

emulate -L zsh
setopt local_options

local verb=${1:-}
(( $# )) && shift

local field=$USER keychain=""
local -a pos
while (( $# )); do
  case $1 in
    -f|--field)    field=${2:?-f needs a field}; shift 2 ;;
    -k|--keychain) keychain=${2:?-k needs a keychain}; shift 2 ;;
    --)            shift; pos+=("$@"); break ;;
    *)             pos+=("$1"); shift ;;
  esac
done
local -a kc; [[ -n $keychain ]] && kc=("$keychain")

case $verb in
  get)
    local service=${pos[1]:-}
    [[ -n $service ]] || { print -u2 "usage: secrets get <service> [-f field]"; return 2 }
    local val
    val=$(security find-generic-password -s "$service" -a "$field" -w "${kc[@]}" 2>/dev/null) || return 1
    printf '%s' "$val"
    ;;
  set)
    local service=${pos[1]:-} value=${pos[2]:-}
    [[ -n $service ]] || { print -u2 "usage: secrets set <service> [value] [-f field]"; return 2 }
    [[ -z $value && ! -t 0 ]] && value=$(cat)
    if [[ -n $value ]]; then
      security add-generic-password -U -s "$service" -a "$field" -l "$service ($field)" -w "$value" "${kc[@]}"
    else
      security add-generic-password -U -s "$service" -a "$field" -l "$service ($field)" -w "${kc[@]}"
    fi
    ;;
  list|ls)
    local service=${pos[1]:-}
    if [[ -n $service ]]; then
      security dump-keychain "${kc[@]}" 2>/dev/null | awk -v svc="$service" '
        /^keychain:|class:/ { a=""; s="" }
        /"acct"<blob>=/ { if (match($0,/="[^"]*"/)) a=substr($0,RSTART+2,RLENGTH-3) }
        /"svce"<blob>=/ { if (match($0,/="[^"]*"/)) s=substr($0,RSTART+2,RLENGTH-3) }
        { if (s==svc && a!="") { print a; a=""; s="" } }'
    else
      local kcsel=${keychain:-$(security list-keychains | tr -d '" ' | fzf)}
      [[ -n $kcsel ]] || return 1
      security dump-keychain "$kcsel" 2>/dev/null \
        | awk -F= '/"svce"<blob>=/ { if ($2 !~ /<NULL>/) print $2 }' | tr -d '"' | sort -u | fzf
    fi
    ;;
  rm|delete)
    local service=${pos[1]:-}
    [[ -n $service ]] || { print -u2 "usage: secrets rm <service> [-f field]"; return 2 }
    security delete-generic-password -s "$service" -a "$field" "${kc[@]}" >/dev/null
    ;;
  keychains) security list-keychains | tr -d '"' ;;
  certs|certificates) security find-certificate -a | fzf ;;
  *)
    print -u2 -- "secrets — macOS keychain secrets (multi-field)
  secrets get  <service> [-f field]           # field defaults to \$USER
  secrets set  <service> [value] [-f field]   # secure prompt if value omitted
  secrets list [service]                        # fields for a service, or browse
  secrets rm   <service> [-f field]
  secrets keychains | certs"
    return 2 ;;
esac

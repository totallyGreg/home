#!/usr/bin/env zsh
# t: smart tmux session/window/pane/command dispatcher.
#
# - t            connect to a session named after the current directory
# - t <name>     connect to a named session (sesh resolves config/tmux/zoxide)
# - t -p         interactive picker (fzf; ~/.config/tmux/scripts/picker); dispatches by entry type:
#                  🪟  prefix → tmux select-window (cross-session)
#                  🧊  prefix → switch-client + select-window + select-pane
#                  ⚡  prefix → run curated tmux subcommand
#                  else      → sesh connect (handles config/tmux/zoxide/fd paths)
#
# This file is autoloaded by zsh (see fpath setup in zfunctions plugin).
# The body below IS the function body — no `t() { ... }` wrapper needed.

emulate -L zsh

if [[ "$1" == "-p" || "$1" == "--pick" ]]; then
  local entry s=$HOME/.config/tmux/scripts/picker
  # Self-contained opts: FZF_DEFAULT_OPTS carries --tmux and a hidden preview. The 16-colour
  # base and -1 (terminal fg/bg) follow Ghostty's light/dark swap. The popup draws the border.
  entry=$($s/source.sh 0 | FZF_DEFAULT_OPTS= fzf --ansi --layout reverse \
    --prompt 'sessions> ' --header 'Tab / Shift-Tab: sessions · windows · panes · commands   prefix / = keys' \
    --pointer '▶' \
    --color '16,fg+:-1:bold,bg+:-1,hl:9,hl+:9:bold,header:-1:dim,pointer:2,prompt:4' \
    --preview "$s/preview.sh {}" --preview-window 'right,50%' \
    --bind "tab:transform:$s/source.sh step 1" \
    --bind "btab:transform:$s/source.sh step -1") || return
  [[ -z "$entry" ]] && return

  case "$entry" in
    *"🧊"*)
      # Pane entry: "🧊  session:win.pane  cmd  [title]"
      # Extract "session:win.pane" — text between leading "🧊  " and next double-space.
      local target="${${entry#*🧊  }%%  *}"
      local sess="${target%%:*}"
      local win="${${target#*:}%%.*}"
      tmux switch-client -t "$sess" \; \
           select-window -t "${sess}:${win}" \; \
           select-pane   -t "$target"
      ;;
    *"🪟"*)
      # Window entry: "🪟  session:idx  window_name  [cmd]"
      # Extract "session:idx" — text between the leading "🪟  " and the next double-space.
      local target="${${entry#*🪟  }%%  *}"
      tmux select-window -t "$target"
      ;;
    *"⚡"*)
      # Command entry: "⚡  name — description ‖ tmux-subcommand"
      # Extract the tmux subcommand after the last "‖ " delimiter.
      local cmd="${entry##*‖ }"
      eval "tmux $cmd"
      ;;
    *)
      # Sesh entry: strip leading icon+space; bare paths (fd) pass through.
      local name
      if [[ "$entry" == /* ]]; then
        name="$entry"
      else
        name="${entry#* }"
      fi
      sesh connect "$name"
      ;;
  esac
  return
fi

if [[ "$#" -gt 1 ]]; then
  echo "Usage: t [name|-p]"
  return 1
fi

sesh connect "${1:-$(basename "$PWD")}"
